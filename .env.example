# --- Site public
NEXT_PUBLIC_SITE_URL=https://example.com
# Lien Planity / Fresha. Vide : réservation interne si NEXT_PUBLIC_BOOKING_INTERNAL=1, sinon WhatsApp.
NEXT_PUBLIC_BOOKING_URL=
# 1 = réservation en ligne sur le site (nécessite Supabase + Resend ci-dessous)
NEXT_PUBLIC_BOOKING_INTERNAL=

# --- Base de données (Supabase, région UE). Exécuter supabase/migrations/0001_init.sql.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- E-mails (Resend)
RESEND_API_KEY=
RESEND_FROM="ZST Beauty Center <rdv@votre-domaine.com>"

# --- Espace de gestion (/admin)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# --- Tâche planifiée des rappels : GET /api/cron/reminders avec « Authorization: Bearer <CRON_SECRET> »
CRON_SECRET=

# --- Comptes de la gestion : l'identifiant « admin » + ADMIN_PASSWORD reste un accès de secours (super admin).
# Les 4 comptes de test (@zst.test) sont créés au premier affichage de la page de connexion, si la base n'a aucun compte.
